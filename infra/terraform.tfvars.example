# Copy to terraform.tfvars (git-ignored) and fill in from the Neon console
# (Project > Branches > prd > Connection details).

pg_host_prd        = "ep-xxxx-xxxx-xxxxxxxx.us-west-2.aws.neon.tech"
pg_host_pooled_prd = "ep-xxxx-xxxx-xxxxxxxx-pooler.us-west-2.aws.neon.tech"
pg_password_prd    = ""

