# Committed, non-secret Postgres connection defaults (Neon).
# Loaded first by every server script; secrets + APP_ENV come from .env.local
# (local) or the deploy's secret store (prod). Layered --env-file: later files win.

PGUSER=neondb_owner
PGDATABASE=neondb

# dev branch (local development + `npm test`)
PGHOST_DEV=ep-odd-firefly-a60gkwfh.us-west-2.aws.neon.tech
PGHOST_POOLED_DEV=ep-odd-firefly-a60gkwfh-pooler.us-west-2.aws.neon.tech

# stg branch (shared staging)
PGHOST_STG=ep-patient-sound-a64ff7u3.us-west-2.aws.neon.tech
PGHOST_POOLED_STG=ep-patient-sound-a64ff7u3-pooler.us-west-2.aws.neon.tech

# PGHOST_PRD / PGHOST_POOLED_PRD — set in the prod deploy's secret store, not here.

# --- Google OIDC auth (non-secret dev defaults) -----------------------------
# The OAuth secrets (AUTH_GOOGLE_CLIENT_ID / _SECRET / AUTH_SESSION_SECRET) live
# in .env.local (local) or the deploy's secret store (stg/prd). These two are
# just URLs and safe to commit for local dev; stg/prd override them.
AUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
AUTH_WEB_ORIGIN=http://localhost:5173
