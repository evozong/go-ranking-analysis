# Copy this file to .env (git-ignored) and fill in a real connection string.
#
# Local development and manual testing should point at the STAGING branch of the Neon
# project, never at production — see plans/03-postgres-stg-prd-migration.md for how to
# create both. Example shape of a Neon connection string:
#
#   postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
#
# In deployed environments, DATABASE_URL is set by the hosting platform's own secret/env
# mechanism instead of this file — production must never be set here.
DATABASE_URL=postgresql://<user>:<password>@<staging-host>.neon.tech/<database>?sslmode=require
