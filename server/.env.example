# Copy to .env.local (git-ignored) and fill in the blanks:
#   cd server && cp .env.example .env.local
#
# APP_ENV lives here — not in the committed .env.defaults — so a prod deploy
# can't accidentally inherit a local value (prod sets APP_ENV=prd in its own
# secret store).
#
# APP_ENV — one of: dev | stg | prd  (selects the PG*_<ENV> connection fields)
#   dev  — your local development branch; `npm run dev` and `npm test` use it
#   stg  — shared staging branch
#   prd  — production (set in the deploy, not here)
# `npm test` does not override APP_ENV — it targets whatever this selects, and
# each test file still runs in its own transient `test_<hex>` schema.

APP_ENV=dev
PGPASSWORD_DEV=
PGPASSWORD_STG=

# --- Google OIDC auth ------------------------------------------------------
# One Google OAuth 2.0 "Web application" client is shared by dev, stg and prd
# (add every callback URL to its "Authorized redirect URIs"). The Client ID /
# secret are not app data — the same pair goes here for local dev and into the
# stg/prd secret stores.
#   Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
#   ID -> Web application. Authorized redirect URIs:
#     http://localhost:3001/api/auth/callback           (dev + local test)
#     https://<stg-host>/api/auth/callback              (stg)
#     https://<prod-host>/api/auth/callback             (prd)
#   OAuth consent screen: External; scopes openid, email, profile; either add
#   invitees as test users or click "Publish app" (no verification needed).
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=
# Optional — sliding session lifetime in days (default 7).
# AUTH_SESSION_TTL_DAYS=7
# AUTH_REDIRECT_URI / AUTH_WEB_ORIGIN default to localhost in .env.defaults;
# override them here only for a non-standard local setup, or in stg/prd.
