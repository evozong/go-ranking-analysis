{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.defaults --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "tsx --env-file=.env.defaults --env-file-if-exists=.env.local --test src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
